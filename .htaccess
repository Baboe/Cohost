# Apache redirect rules — force the single canonical host (https://cohostdordogne.com)
# so Google stops indexing www / http duplicates of every page.
# See README.md "Canonical host" section if deploying elsewhere.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Force apex domain (redirect www to non-www), except search-engine
  # site-verification files — verification bots check the exact host you
  # registered under and don't treat a redirect as a pass
  RewriteCond %{HTTP_HOST} ^www\.cohostdordogne\.com$ [NC]
  RewriteCond %{REQUEST_URI} !^/BingSiteAuth\.xml$
  RewriteRule ^(.*)$ https://cohostdordogne.com/$1 [L,R=301]
</IfModule>

ErrorDocument 404 /404.html

# Browser caching — CSS and images referenced from /css/ and /assets/ are
# cache-busted with a "?v=N" query string (bump it in the HTML when the file
# changes), so it's safe to cache them for a long time. The favicon isn't
# versioned, so it gets a shorter cache. HTML is revalidated on every
# request since it isn't versioned. See README.md "Browser caching" section.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|jpe?g|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <Files "placeholder-hero.svg">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </Files>
  <Files "favicon.svg">
    Header set Cache-Control "public, max-age=604800"
  </Files>
</IfModule>
